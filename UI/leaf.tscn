[sub_resource type="GDScript" id="GDScript_y0aog"]
script/source = "extends Node

func _process(delta):
	# Mendapatkan transformasi canvas
	var canvas = get_canvas_transform()
	var top_left = -canvas.origin / canvas.get_scale()
	var size = get_viewport_rect().size / canvas.get_scale()

	# Mengatur posisi global CPUParticles2D
	$GPUParticles2D.global_position.x = top_left.x + size.x / 2
	$GPUParticles2D.global_position.y = top_left.y + 50

	# Mengatur bentuk emisi (gunakan EmissionShape)
	var emission_shape = $CPUParticles2D.emission_shape
	emission_shape.extents = Vector3(size.x, 50, 1)
"

